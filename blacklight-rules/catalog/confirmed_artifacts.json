{
  "schema_version": "blacklight.rules.catalog.v2",
  "description": "Confirmed artifact surfaces emitted by Blacklight endpoint assessment or consumed by Blacklight session analysis.",
  "default_confidence": "confirmed",
  "assessment_coverage_states": {
    "explicitly_assessed": "The exact path is a static endpoint-assessment target.",
    "recursively_discovered": "A bounded Scout or SessionSource traversal recognizes matching descendants.",
    "intentionally_deferred": "The artifact is cataloged for defensive visibility but is not currently emitted or parsed as an individual artifact."
  },
  "evidence_sources": {
    "blacklight.scout.PATH_TARGETS": {
      "kind": "catalog",
      "path": "blacklight-scout/catalog/targets.json",
      "note": "Legacy evidence key retained for artifact compatibility; the JSON target catalog is authoritative."
    },
    "blacklight.scout.endpoint_assessment": {
      "kind": "code",
      "path": "blacklight-scout/native/ai_path_scout_windows.c",
      "note": "Native Windows implementation of the count-only configuration, permission, authentication, and database existence assessment; managed parity is validated by the executable smoke tests."
    },
    "blacklight.scout.endpoint_assessment_posix": {
      "kind": "code",
      "path": "blacklight-scout/native/ai_path_scout_posix.c",
      "note": "Native macOS and Linux existence checks report only database file metadata."
    },
    "blacklight.analyze.run_session_detail": {
      "kind": "code",
      "path": "blacklight/analyze.py",
      "symbol": "run_session_detail"
    },
    "blacklight.rules.osquery_inventory_windows": {
      "kind": "code",
      "path": "blacklight-rules/inventory/blacklight_artifact_inventory_windows.sql",
      "note": "Metadata-only Windows endpoint inventory; database contents are not parsed."
    },
    "blacklight.rules.osquery_inventory_posix": {
      "kind": "code",
      "path": "blacklight-rules/inventory/blacklight_artifact_inventory_posix.sql",
      "note": "Metadata-only POSIX endpoint inventory; database contents are not parsed."
    }
  },
  "detection_boundaries": {
    "windows_roots": [
      "\\.codex",
      "\\.claude",
      "\\.cursor",
      "\\.gemini\\antigravity-cli",
      "\\.grok"
    ],
    "posix_roots": [
      "/.codex",
      "/.claude",
      "/.cursor",
      "/.gemini/antigravity-cli",
      "/.grok"
    ],
    "standalone_home_files": [
      ".claude.json"
    ],
    "match_policy": "Match an exact root or a descendant separated by the platform path separator. Do not match lookalike siblings such as .codex-old."
  },
  "rule_surfaces": [
    "windows_security_4663",
    "linux_auditd",
    "macos_endpoint_security",
    "osquery_inventory",
    "windows_acl_inventory",
    "velociraptor_collection"
  ],
  "root_match_fragments": [
    ".codex/",
    ".claude/",
    ".claude.json",
    ".cursor/",
    ".gemini/antigravity-cli/",
    ".grok/"
  ],
